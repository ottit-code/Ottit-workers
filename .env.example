# =========================================================================
# Ottit Workers — environment variables
# Copy to .env (which is gitignored) and fill in real values.
# =========================================================================

# --- Existing ------------------------------------------------------------
# Deployment environment. Set to "development" to allow the auth bypass when
# API_KEY / DRAFTER_API_KEY are left blank. Any other value (incl. the default
# "production") fails closed with 503 when a required key is missing.
APP_ENV=production

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=

EMAILBISON_API_TOKEN=
EMAILBISON_TEAM_ID=
EMAILGUARD_API_TOKEN=
EMAILGUARD_WORKSPACE_UUID=

# InboxAssure placement scores (optional — integration is dormant until the
# token is set; the poller and /deliverability/inboxassure then activate).
INBOXASSURE_API_TOKEN=
INBOXASSURE_BASE_URL=https://inboxassure.app

# Dashboard read-API auth (existing /stats, /campaigns, etc.)
API_KEY=

# Webhook signing secret for the legacy /webhook route
WEBHOOK_SECRET=

# Slack relay used by existing notifications.py (optional)
SLACK_WEBHOOK_URL=

# CORS — comma-separated; leave empty to allow all (dev only)
ALLOWED_ORIGINS=

# --- Drafter (AI auto-responder) -----------------------------------------

# Bearer token n8n uses to call POST /webhooks/bison/lead-interested
DRAFTER_API_KEY=

# Bearer token for /admin/* (backfill, drafts listing). Keep separate from DRAFTER_API_KEY.
ADMIN_API_KEY=

# LLM providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Models — defaults match the plan. Override only if you need to.
CLAUDE_MODEL_PRIMARY=claude-opus-5
CLAUDE_MODEL_ENSEMBLE=claude-haiku-4-5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Voice assets in Supabase Storage
VOICE_BUCKET=voice-assets
# Paths *inside* the bucket. Override if you store the files under different names.
VOICE_INSTRUCTIONS_PATH=saman-writing-style-cold-email.md
VOICE_SKILL_PATH=saman-cold-email-voice.skill
VOICE_CACHE_TTL_SECONDS=300

# RAG
RAG_TOP_K=5

# Pipeline hard cap (seconds)
DRAFT_TIMEOUT_SECONDS=60
