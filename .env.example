# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-key

# EmailBison API
EMAILBISON_API_TOKEN=your-emailbison-token

# EmailGuard API
EMAILGUARD_API_TOKEN=your-emailguard-token

# Webhook
WEBHOOK_SECRET=your-webhook-secret

# Optional: Slack alerts
SLACK_WEBHOOK_URL=

# Optional: SMTP for email digests
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
